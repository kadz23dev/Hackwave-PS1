# Kaizen AI Environment Configuration
# Copy this file to .env and provide your secrets/API keys.

# Server & Storage
PORT=4300
HEALTEST_HOME=demo-home
HEALTEST_LLM=replay
# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Firebase Authentication & Web Configuration
# Retrieve these credentials from your Firebase Console -> Project Settings -> General -> Your Apps
FIREBASE_API_KEY=AIzaSyDummyKeyForKaizenAiTestingOnly999
FIREBASE_AUTH_DOMAIN=kaizen-ai-demo.firebaseapp.com
FIREBASE_PROJECT_ID=kaizen-ai-demo
FIREBASE_STORAGE_BUCKET=kaizen-ai-demo.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
FIREBASE_MEASUREMENT_ID=G-ABCDEF1234
